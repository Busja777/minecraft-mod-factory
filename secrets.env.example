# ─────────────────────────────────────────────────────────────
#  Mod Factory – Secrets
#  1. Kopie anlegen:   cp secrets.env.example secrets.env
#  2. Werte eintragen (ohne Anführungszeichen, ohne Leerzeichen um =)
#  3. Übertragen:      npm run secrets:push
#  secrets.env ist per .gitignore (*.env) vom Git ausgeschlossen.
# ─────────────────────────────────────────────────────────────

# Pflicht. console.anthropic.com → API Keys (beginnt mit sk-ant-)
ANTHROPIC_API_KEY=

# Pflicht. curseforge.com → Account → My API Tokens
# Muss eine UUID sein: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NICHT der Studios-Key ($2a$...), der gibt "API token is malformed".
CF_API_TOKEN=

# Ab Phase 2 (ChatGPT-Bilder). platform.openai.com → API keys (beginnt mit sk-)
OPENAI_API_KEY=

# Bis Phase 2 noch für das Icon im Einsatz. fal.ai → Keys
FAL_API_KEY=

# Optional, Modrinth ist aktuell aus. modrinth.com → Settings → PATs
MODRINTH_API_TOKEN=

# ── Infos (werden NICHT als GitHub-Secret hochgeladen) ──────
# Numerische ID deines CurseForge-Testprojekts (steht rechts auf der Projektseite)
CF_TEST_PROJECT_ID=
